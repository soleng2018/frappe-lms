# Copy to .env with `make init`. Never commit .env.
# Keys marked "fixed" must not change after the first start.

# LMS
# Public hostname (fixed). Site name, Traefik host rule, tools base URL
LMS_HOSTNAME=
LMS_ADMIN_PASSWORD=
LMS_ENCRYPTION_KEY=
LMS_SERVICE_USER=nile-tools@example.com
LMS_API_KEY=
LMS_API_SECRET=

# DB
DB_ROOT_PASSWORD=

# AUTHENTIK
AUTHENTIK_HOSTNAME=
AUTHENTIK_API_TOKEN=
AUTHENTIK_APP_SLUG=nile-lms
AUTHENTIK_ADMIN_GROUP=hol-admins
AUTHENTIK_STUDENT_GROUP_PREFIX=NileWorkshop
AUTHENTIK_STUDENT_GROUP_SUFFIX=Admin

# TRAEFIK
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
