# Nile Workshop LMS settings. This file is generated: edit the key list in tools, not this.
#
# First run:
#   1. make init     creates .env from this file and fills every generated secret
#   2. edit .env     set the blank operator keys
#   3. make check    then make up
#
# Never commit .env. Keep a private copy of it: without LMS_ENCRYPTION_KEY a restored
# database cannot be read. (fixed) = never change after the first start.
# (generated) = make init fills it for you.
# A value may use only A-Za-z0-9_.:/@+=,- (no quotes, spaces, $ or #).

# == LMS ==
# Public hostname. Site name, Traefik host rule, tools base URL (fixed)
LMS_HOSTNAME=
# Frappe Administrator password (fixed) (generated)
LMS_ADMIN_PASSWORD=
# Frappe encryption_key. Keep a private copy: restores need it (fixed) (generated)
LMS_ENCRYPTION_KEY=
# Service user id (email shaped) used by the tools (fixed)
LMS_SERVICE_USER=nile-tools@example.com
# Site timezone (IANA name). New batches and the Desk use it
LMS_TIMEZONE=America/Los_Angeles
# Service user API key (fixed) (generated)
LMS_API_KEY=
# Service user API secret (fixed) (generated)
LMS_API_SECRET=
# MCP user id (email shaped) for your AI agent. Not the tools user (fixed)
LMS_MCP_USER=nile-mcp@example.com
# MCP user API key. Rotate by editing it, then make up (generated)
LMS_MCP_API_KEY=
# MCP user API secret. Rotate by editing it, then make up (generated)
LMS_MCP_API_SECRET=

# == DB ==
# MariaDB root password. Ignored by MariaDB after first start (fixed) (generated)
DB_ROOT_PASSWORD=

# == AUTHENTIK ==
# Authentik hostname (the URL is https:// plus this)
AUTHENTIK_HOSTNAME=
# Authentik master API token
AUTHENTIK_API_TOKEN=
# Slug of the Authentik application the script creates (fixed)
AUTHENTIK_APP_SLUG=nile-lms
# Group that becomes admin
AUTHENTIK_ADMIN_GROUP=hol-admins

# == TRAEFIK ==
# External Docker network Traefik listens on
TRAEFIK_NETWORK=traefik
# Traefik entrypoint
TRAEFIK_ENTRYPOINT=websecure
# Traefik certificate resolver
TRAEFIK_CERT_RESOLVER=letsencrypt
