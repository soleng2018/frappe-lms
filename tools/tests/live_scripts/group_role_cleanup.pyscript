# Runs inside `bench console`. Removes what the concurrent test committed.
import json
import frappe

group = "NileWorkshop__N__Admin"
for email in ("__A__", "__B__"):
    for dt in ("LMS Enrollment", "LMS Batch Enrollment"):
        for n in frappe.get_all(dt, {"member": email}, pluck="name"):
            frappe.delete_doc(dt, n, force=True, ignore_permissions=True)
for n in frappe.get_all("LMS Batch", {"nile_group": group}, pluck="name"):
    frappe.delete_doc("LMS Batch", n, force=True, ignore_permissions=True)
for email in ("__A__", "__B__"):
    if frappe.db.exists("User", email):
        frappe.delete_doc("User", email, force=True, ignore_permissions=True)
frappe.db.commit()
print("RESULT:" + json.dumps({"left": frappe.db.count("LMS Batch", {"nile_group": group})}))
