# Runs inside `bench console` (see test_content_sync_integration.py); __P__ is the test prefix.
import json, frappe
p = "__P__"
out = {}
try:
    course = frappe.db.get_value("LMS Course", {"nile_key": p + "-course"})
    lessons = {k: frappe.db.get_value("Course Lesson", {"nile_key": f"__P__-{k}"}) for k in ("video", "vq", "lab", "lq")}
    frappe.get_doc({"doctype": "LMS Enrollment", "member": p + "-student@example.com", "course": course}).insert(ignore_permissions=True)
    for k in ("video", "vq", "lab"):
        frappe.get_doc({"doctype": "LMS Course Progress", "member": p + "-student@example.com", "course": course,
            "lesson": lessons[k], "status": "Complete"}).insert(ignore_permissions=True)
    frappe.db.commit()
    out["ok"] = True
except Exception as e:
    frappe.db.rollback()
    out["error"] = type(e).__name__ + ": " + str(e)[:300]
print("RESULT:" + json.dumps(out))
