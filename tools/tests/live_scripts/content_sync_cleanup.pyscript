# Runs inside `bench console` (see test_content_sync_integration.py); __P__ is the test prefix.
import json, frappe
p = "__P__"
out = {}
try:
    course = frappe.db.get_value("LMS Course", {"nile_key": p + "-course"})
    for dt, flt in (("LMS Course Progress", {"course": course}), ("LMS Enrollment", {"course": course})):
        for n in frappe.get_all(dt, filters=flt, pluck="name") if course else []:
            frappe.delete_doc(dt, n, force=True, ignore_permissions=True)
    for n in frappe.get_all("LMS Batch", filters={"nile_group": f"NileWorkshop__P__Admin"}, pluck="name"):
        frappe.delete_doc("LMS Batch", n, force=True, ignore_permissions=True)
    for dt in ("LMS Quiz", "Course Lesson", "Course Chapter", "LMS Course", "LMS Question"):
        for n in frappe.get_all(dt, filters={"nile_key": ["like", p + "-%"]}, pluck="name"):
            frappe.delete_doc(dt, n, force=True, ignore_permissions=True)
    if frappe.db.exists("User", p + "-student@example.com"):
        frappe.delete_doc("User", p + "-student@example.com", force=True, ignore_permissions=True)
    frappe.db.commit()
    out["ok"] = True
except Exception as e:
    frappe.db.rollback()
    out["error"] = type(e).__name__ + ": " + str(e)[:300]
print("RESULT:" + json.dumps(out))
