# Runs inside `bench console` (see test_content_sync_integration.py); __P__ is the test prefix.
import json, frappe
from frappe.utils import nowdate, add_years
out = {}
try:
    user = frappe.get_doc({"doctype": "User", "email": "__P__-student@example.com", "first_name": "it",
        "user_type": "Website User", "send_welcome_email": 0, "roles": [{"role": "LMS Student"}]}).insert(ignore_permissions=True)
    frappe.get_doc({"doctype": "LMS Batch", "title": "__P__ batch", "nile_group": "NileWorkshop__P__Admin",
        "start_date": nowdate(), "end_date": add_years(nowdate(), 10), "start_time": "00:00:00",
        "end_time": "23:59:59", "timezone": "UTC", "description": "x", "batch_details": "x",
        "published": 1, "instructors": [{"instructor": "nile-tools@example.com"}]}).insert(ignore_permissions=True)
    frappe.db.commit()
    out["ok"] = True
except Exception as e:
    frappe.db.rollback()
    out["error"] = type(e).__name__ + ": " + str(e)[:300]
print("RESULT:" + json.dumps(out))
