# Runs inside `bench console`; removes what the pass rules test made. Run before content_sync_edges_cleanup.
import json, frappe
out = {}
try:
    p = "__P__"
    course = frappe.db.get_value("LMS Course", {"nile_key": p + "-course"})
    users = [f"{p}-{k}@example.com" for k in ("student", "other", "admin")]
    if course:
        for n in frappe.get_all("LMS Certificate", filters={"course": course}, pluck="name"):
            frappe.delete_doc("LMS Certificate", n, force=True, ignore_permissions=True)
    quizzes = frappe.get_all("LMS Quiz", filters={"nile_key": ["like", p + "-%"]}, pluck="name")
    for n in frappe.get_all("LMS Quiz Submission", filters={"quiz": ["in", quizzes or [""]]}, pluck="name"):
        frappe.delete_doc("LMS Quiz Submission", n, force=True, ignore_permissions=True)
    for u in users:
        if frappe.db.exists("User", u):
            frappe.delete_doc("User", u, force=True, ignore_permissions=True)
    frappe.db.commit()
    out["ok"] = True
except Exception as e:
    frappe.db.rollback()
    out["error"] = type(e).__name__ + ": " + str(e)[:300]
print("RESULT:" + json.dumps(out))
