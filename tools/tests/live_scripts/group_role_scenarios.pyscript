# Runs inside `bench console` (see test_group_role_mapping_integration.py). Rolls everything back.
# The IDP call and Frappe's final login step are replaced; everything else is the real code path.
# Spec 0009: course groups. Two throwaway managed courses are made, unpublished, as sync leaves them.
import json
import types

import frappe
import nile_auth.login as L

out = {}
frappe.db.commit = lambda *a, **k: None  # nothing may be kept, not even the role strip
logins = []
current = {}


def fake_info(provider, code, decoder=None):
    return dict(current["info"])


def fake_login(info, *, provider=None, state=None):
    # What Frappe's step leaves after a good login: a redirect response and the session user.
    logins.append((info["email"], provider, state))
    frappe.cache.delete_value(f"frappe_oauth_login:{state}")
    frappe.local.response["type"] = "redirect"
    frappe.local.response["location"] = current.get("redirect", "/app")
    frappe.session.user = info["email"].lower()


real_fault = L._log_fault


def keep_fault(code, state):
    out.setdefault("traces", []).append(frappe.get_traceback(with_context=False)[-1200:])
    real_fault(code, state)


L._log_fault = keep_fault
L.get_info_via_oauth = fake_info
L.login_oauth_user = fake_login
frappe.local.request = types.SimpleNamespace(
    path="/api/method/frappe.integrations.oauth2_logins.custom/nileprobe"
)
sfx = frappe.generate_hash(length=6)
STUDENT, ADMIN_ROLES = "LMS Student", {"Moderator", "Course Creator", "Desk User"}


def login(email, groups, sub="sub-" + sfx, state=True, redirect="/app", code="CODE-SECRET-123"):
    info = {"email": email, "sub": sub, "name": "Nile Test", "groups": groups}
    if groups == "__absent__":
        del info["groups"]
    current["info"] = info
    current["redirect"] = redirect
    token = "STATE-" + frappe.generate_hash(length=8)
    if state:
        frappe.cache.set_value(f"frappe_oauth_login:{token}", redirect)
    frappe.local.response = frappe._dict()
    before = len(logins)
    frappe.session.user = "Guest"
    L.custom(code, token)
    got = {
        "status": frappe.local.response.get("http_status_code"),
        "signed_in": len(logins) > before,
        "location": frappe.local.response.get("location") if len(logins) > before else None,
    }
    frappe.session.user = "Guest"
    return got


def roles(user):
    return set(frappe.get_roles(user))


def count(dt, **flt):
    return frappe.db.count(dt, flt)


def enrolled(user):
    return sorted(frappe.get_all("LMS Enrollment", {"member": user}, pluck="course"))


def state(user):
    return {
        "roles": sorted(frappe.get_all("Has Role", {"parent": user, "parenttype": "User"}, pluck="role")),
        "enrolled": enrolled(user),
        "groups": frappe.db.get_value("User", user, "nile_groups"),
        "enabled": frappe.db.get_value("User", user, "enabled"),
    }


def queued_jobs():
    from frappe.utils.background_jobs import get_queues

    return sum(q.count for q in get_queues())


def make_course(title, key):
    return frappe.get_doc(
        {
            "doctype": "LMS Course",
            "title": title,
            "nile_key": key,
            "short_introduction": "x",
            "description": "x",
            "published": 0,
            "instructors": [{"instructor": frappe.conf.nile_service_user}],
        }
    ).insert(ignore_permissions=True)


try:
    ta, tb = f"Nile IT A {sfx}", f"Nile IT B {sfx}"
    a = make_course(ta, "it-a-" + sfx)
    b = make_course(tb, "it-b-" + sfx)
    ch = frappe.get_doc({"doctype": "Course Chapter", "title": "c", "course": a.name}).insert(ignore_permissions=True)
    ls = frappe.get_doc(
        {"doctype": "Course Lesson", "title": "l", "chapter": ch.name, "course": a.name, "body": "x"}
    ).insert(ignore_permissions=True)
    ch.reload()
    if not any(r.lesson == ls.name for r in ch.lessons):
        ch.append("lessons", {"lesson": ls.name})
        ch.save(ignore_permissions=True)
    a.reload()
    if not any(r.chapter == ch.name for r in a.chapters):
        a.append("chapters", {"chapter": ch.name})
        a.save(ignore_permissions=True)
    out["names"] = [a.name, b.name]

    batches_before = [count("LMS Batch"), count("LMS Batch Enrollment"), count("Batch Course")]
    mail_before = count("Email Queue")
    jobs_before = queued_jobs()

    # AC-1, AC-10, AC-11: a first login with one course group
    s = f"nile-it-s-{sfx}@example.com"
    out["first"] = login(s, ["staff", ta])
    u = frappe.get_doc("User", s)
    out["student"] = {
        "user_type": u.user_type,
        "state": state(s),
        "from_batch": frappe.db.get_value("LMS Enrollment", {"member": s, "course": a.name}, "enrollment_from_batch"),
        "username": u.username,
    }
    from lms.lms.permissions import can_access_lesson as _cal

    try:
        frappe.set_user(s)
        out["own_lesson"] = bool(_cal(ls.name))
    finally:
        frappe.set_user("Guest")
    # AC-9: logging in again changes nothing
    before = state(s)
    login(s, [ta])
    out["repeat_same"] = before == state(s) and count("LMS Enrollment", member=s) == 1

    # AC-1/AC-3: a move to B removes A; progress rows stay
    frappe.set_user("Administrator")
    frappe.get_doc(
        {"doctype": "LMS Course Progress", "course": a.name, "lesson": ls.name, "member": s, "status": "Complete", "chapter": ch.name}
    ).insert(ignore_permissions=True)
    frappe.set_user("Guest")
    out["moved"] = login(s, [tb])
    out["moved_state"] = state(s)
    out["progress_kept"] = count("LMS Course Progress", member=s)

    # AC-13: live in B, A is closed to the learner
    from lms.lms.permissions import can_access_course, can_access_lesson, chapter_has_permission

    def as_user(user, fn):
        try:
            frappe.set_user(user)
            return bool(fn())
        finally:
            frappe.set_user("Guest")

    out["isolation"] = {
        "own_access": as_user(s, lambda: can_access_course(b.name)),
        "other_access": as_user(s, lambda: can_access_course(a.name)),
        "other_lesson": as_user(s, lambda: can_access_lesson(ls.name)),
        "other_chapter": as_user(s, lambda: chapter_has_permission(frappe.get_doc("Course Chapter", ch.name), "read")),
    }
    try:
        frappe.set_user(s)
        frappe.get_doc({"doctype": "LMS Enrollment", "course": a.name, "member": s}).insert()
        out["self_enroll"] = "allowed"
    except Exception as e:
        out["self_enroll"] = type(e).__name__
    finally:
        frappe.set_user("Guest")

    # AC-13 more: the catalog, the course row, a quiz of A, and a Program that holds A
    def listed(doctype):
        try:
            frappe.set_user(s)
            return frappe.get_list(doctype, pluck="name", limit_page_length=0)
        except frappe.PermissionError:
            return None  # the learner may not list this doctype at all, so nothing leaks
        finally:
            frappe.set_user("Guest")

    def catalog_api():
        try:
            frappe.set_user(s)
            fn = frappe.get_attr("lms.lms.utils.get_courses")
            while hasattr(fn, "__wrapped__"):  # past the rate limit, which needs a real request
                fn = fn.__wrapped__
            return [c.get("name") for c in (fn() or [])]
        except Exception as e:
            return type(e).__name__ + ": " + str(e)[:120]
        finally:
            frappe.set_user("Guest")

    api = catalog_api()
    out["catalog"] = {
        "list_denied": listed("LMS Course") is None,
        "list_sees_a": a.name in (listed("LMS Course") or []),
        "api": api if isinstance(api, str) else {"sees_a": a.name in api, "sees_b": b.name in api},
        "row_a": as_user(s, lambda: frappe.has_permission("LMS Course", "read", a.name)),
    }
    quiz = frappe.get_doc({"doctype": "LMS Quiz", "title": "q " + sfx, "course": a.name}).insert(
        ignore_permissions=True
    )
    out["quiz_a"] = {
        "listed": quiz.name in (listed("LMS Quiz") or []),
        "read": as_user(s, lambda: frappe.has_permission("LMS Quiz", "read", quiz.name)),
    }
    program = frappe.get_doc(
        {
            "doctype": "LMS Program", "title": "Nile IT P " + sfx, "published": 1,
            "program_courses": [{"course": a.name}], "program_members": [{"member": s}],
        }
    ).insert(ignore_permissions=True)
    out["program"] = {
        "course_access": as_user(s, lambda: can_access_course(a.name)),
        "lesson_access": as_user(s, lambda: can_access_lesson(ls.name)),
    }
    try:
        frappe.set_user(s)
        frappe.get_doc({"doctype": "LMS Enrollment", "course": a.name, "member": s}).insert()
        out["program"]["self_enroll"] = "allowed"
    except Exception as e:
        out["program"]["self_enroll"] = type(e).__name__
    finally:
        frappe.set_user("Guest")

    # AC-3, AC-11: results mode, then back to live with the progress rebuilt (AC-1)
    out["results"] = login(s, ["staff"])
    out["results_state"] = state(s)
    out["results_progress_kept"] = count("LMS Course Progress", member=s)
    out["back_live"] = login(s, [ta])
    out["back_live_progress"] = frappe.db.get_value("LMS Enrollment", {"member": s, "course": a.name}, "progress")

    # AC-11: a real deep link wins, and the default targets count as absent
    out["deep"] = login(s, [ta], redirect="/lms/courses/other/learn/1.1")["location"]
    out["default_targets"] = [login(s, [ta], redirect=r)["location"] for r in ("/", "/me", "/app", "/lms", "/lms/courses/")]

    # AC-2: admin only, admin plus a course, admin demoted
    ad = f"nile-it-a-{sfx}@example.com"
    out["admin_login"] = login(ad, ["hol-admins"], sub="sub-a" + sfx)
    ua = frappe.get_doc("User", ad)
    out["admin"] = {"state": state(ad), "type": ua.user_type, "student_role": STUDENT in roles(ad)}
    login(ad, ["hol-admins", ta], sub="sub-a" + sfx)
    out["admin_live"] = state(ad)
    out["admin_live_location"] = login(ad, ["hol-admins", ta], sub="sub-a" + sfx)["location"]
    login(ad, [ta], sub="sub-a" + sfx)
    out["admin_demoted"] = {"state": state(ad), "type": frappe.db.get_value("User", ad, "user_type")}
    out["admin_results_location"] = None
    # an admin who holds LMS Student and has no course group stays in results mode and lands on /lms
    out["admin_results_location"] = login(ad, ["hol-admins"], sub="sub-a" + sfx)["location"]
    out["admin_results_state"] = state(ad)

    # AC-4: no course group, not a known learner
    n = f"nile-it-n-{sfx}@example.com"
    out["nogroup_new"] = login(n, ["staff"])
    out["nogroup_new_user"] = bool(frappe.db.exists("User", n))
    out["empty_list_new"] = login(n, [])
    # a non learner with admin roles loses them and keeps enabled
    m = f"nile-it-m-{sfx}@example.com"
    um = frappe.get_doc({"doctype": "User", "email": m, "first_name": "m", "send_welcome_email": 0,
                         "roles": [{"role": r} for r in sorted(ADMIN_ROLES)]}).insert(ignore_permissions=True)
    frappe.db.delete("Has Role", {"parent": m, "role": STUDENT})
    out["nonlearner"] = login(m, ["staff"])
    out["nonlearner_state"] = state(m)

    # AC-5: near misses
    out["near_miss"] = [login(n, [g])["status"] for g in (ta.lower(), ta + " ", "Sales")]
    out["near_miss_user"] = bool(frappe.db.exists("User", n))

    # AC-6: two courses, whoever the user is, nothing changes
    dis = f"nile-it-d-{sfx}@example.com"
    login(dis, [ta], sub="sub-d" + sfx)
    frappe.db.set_value("User", dis, "enabled", 0)
    snap = {x: state(x) for x in (s, ad, dis)}
    out["two"] = [login(x, [ta, tb] + (["hol-admins"] if x == ad else []), sub="sub-" + k + sfx)
                  for x, k in ((s, ""), (ad, "a"), (dis, "d"))]
    out["two_unchanged"] = snap == {x: state(x) for x in (s, ad, dis)}
    out["two_new"] = login(f"nile-it-t-{sfx}@example.com", [ta, tb])["status"]
    out["two_new_user"] = bool(frappe.db.exists("User", f"nile-it-t-{sfx}@example.com"))

    # AC-7: faults change nothing
    snap = state(s)
    out["no_claim"] = login(s, "__absent__")["status"]
    out["bad_claim"] = login(s, "hol-admins")["status"]
    saved = frappe.conf.get("nile_admin_group")
    frappe.conf["nile_admin_group"] = ""
    try:
        out["empty_admin_setting"] = login(s, [ta])["status"]
    finally:
        frappe.conf["nile_admin_group"] = saved
    dup = make_course(ta, "it-dup-" + sfx)
    out["duplicate_title"] = login(s, [ta])["status"]
    frappe.delete_doc("LMS Course", dup.name, force=True, ignore_permissions=True)
    out["faults_unchanged"] = snap == state(s)

    # AC-8: protected accounts and an identity mismatch
    g = [ta]
    out["administrator"] = login("Administrator", g, sub="x")["status"]
    admin_email = frappe.db.get_value("User", "Administrator", "email")
    admin_before = state("Administrator")
    out["administrator_email"] = login(admin_email, g, sub="x")["status"]
    out["administrator_email_unchanged"] = admin_before == state("Administrator")
    out["service"] = login(frappe.conf.nile_service_user, g, sub="x")["status"]
    mcp = frappe.conf.nile_mcp_user
    out["mcp"] = login(mcp, g, sub="x")["status"] if mcp else None
    sm = f"nile-it-sm-{sfx}@example.com"
    frappe.get_doc({"doctype": "User", "email": sm, "first_name": "m", "send_welcome_email": 0,
                    "roles": [{"role": "System Manager"}]}).insert(ignore_permissions=True)
    sm_before = state(sm)
    out["system_manager"] = login(sm, g, sub="x")["status"]
    out["sm_unchanged"] = sm_before == state(sm)
    o = f"nile-it-o-{sfx}@example.com"
    login(o, g, sub="sub-o" + sfx)
    uo = frappe.get_doc("User", o)
    uo.set_social_login_userid("nileprobe", userid="sub-o" + sfx)
    uo.flags.ignore_permissions = True
    uo.save()
    out["same_sub_ok"] = login(o, g, sub="sub-o" + sfx)["signed_in"]
    out["identity"] = login(o, g, sub="somebody-else")["status"]
    out["no_email"] = login("", g)["status"]
    # a disabled user stays disabled and keeps nothing new
    d_before = state(dis)
    login(dis, [tb], sub="sub-d" + sfx)
    out["disabled_same"] = d_before == state(dis)

    # AC-9: a bad state is refused before anything is written
    bs = f"nile-it-b-{sfx}@example.com"
    out["bad_state"] = login(bs, g, state=False)["status"]
    out["bad_state_user"] = bool(frappe.db.exists("User", bs))

    # AC-10: no batch rows, no mail, no job
    out["batches_same"] = batches_before == [count("LMS Batch"), count("LMS Batch Enrollment"), count("Batch Course")]
    out["mail_queued"] = count("Email Queue") - mail_before
    out["jobs_queued"] = queued_jobs() - jobs_before

    # AC-15: the log lines
    out["log_tail"] = [
        x for x in open(frappe.get_site_path("logs", "nile_auth.log")).read().splitlines()
        if sfx in x or "CODE-SECRET" in x or "STATE-" in x
    ][-60:]

    # AC-9: a fault halfway leaves nothing behind. This rolls the whole run back, so it is last.
    f = f"nile-it-f-{sfx}@example.com"
    real = L._enroll

    def boom(*args, **kwargs):
        raise RuntimeError("forced")

    L._enroll = boom
    out["fault"] = login(f, g, sub="sub-f" + sfx)
    L._enroll = real
    out["fault_user"] = bool(frappe.db.exists("User", f))
except Exception:
    import traceback

    out["error"] = traceback.format_exc()[-1800:]
finally:
    frappe.db.rollback()
print("RESULT:" + json.dumps(out, default=str))
