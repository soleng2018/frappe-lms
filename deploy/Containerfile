# syntax=docker/dockerfile:1

# Adapted from frappe_docker images/custom/Containerfile at the tag in deploy/versions.env.
# Differences: the base image is pinned by digest, upstream files come from the named
# build context `fd` (a checkout of that tag), and apps/nile_auth is installed from this repo.
ARG PYTHON_VERSION
ARG DEBIAN_BASE
ARG PYTHON_BASE_DIGEST
FROM python:${PYTHON_VERSION}-slim-${DEBIAN_BASE}@${PYTHON_BASE_DIGEST} AS base

COPY --from=fd resources/core/nginx/nginx-template.conf /templates/nginx/frappe.conf.template
COPY --from=fd resources/core/nginx/nginx-entrypoint.sh /usr/local/bin/nginx-entrypoint.sh
COPY --from=fd resources/core/nginx/security_headers.conf /etc/nginx/snippets/security_headers.conf

ARG WKHTMLTOPDF_VERSION=0.12.6.1-3
ARG WKHTMLTOPDF_DISTRO=bookworm
ARG INSTALL_CHROMIUM=true

ARG NODE_VERSION
ARG BENCH_VERSION
ENV NVM_DIR=/home/frappe/.nvm
ENV NVM_SYMLINK_CURRENT=true
ENV PATH=${NVM_DIR}/current/bin/:${PATH}

RUN useradd -u 1000 -g 0 -d /home/frappe -ms /bin/bash frappe \
    && apt-get update \
    && apt-get install --no-install-recommends -y \
    ca-certificates \
    curl \
    git \
    vim \
    nginx \
    gettext-base \
    file \
    # weasyprint dependencies
    libpango-1.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    # For backups
    restic \
    gpg \
    # MariaDB
    mariadb-client \
    less \
    # Postgres
    libpq-dev \
    postgresql-client \
    # For healthcheck
    wait-for-it \
    jq \
    # For MIME type detection
    media-types \
    && . /etc/os-release \
    && if [ "$VERSION_CODENAME" = "trixie" ]; then \
        apt-get install --no-install-recommends -y tzdata-legacy; \
    fi \
    # NodeJS
    && mkdir -p ${NVM_DIR} \
    && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.6/install.sh | bash \
    && . ${NVM_DIR}/nvm.sh \
    && nvm install ${NODE_VERSION} \
    && nvm use ${NODE_VERSION} \
    && npm install -g yarn \
    && corepack enable pnpm \
    && nvm alias default ${NODE_VERSION} \
    && rm -rf ${NVM_DIR}/.cache \
    && echo 'export NVM_DIR="/home/frappe/.nvm"' >>/home/frappe/.bashrc \
    && echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm' >>/home/frappe/.bashrc \
    && echo '[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion' >>/home/frappe/.bashrc \
    # Install wkhtmltopdf with patched qt
    && if [ "$(uname -m)" = "aarch64" ]; then export ARCH=arm64; fi \
    && if [ "$(uname -m)" = "x86_64" ]; then export ARCH=amd64; fi \
    && downloaded_file=wkhtmltox_${WKHTMLTOPDF_VERSION}.${WKHTMLTOPDF_DISTRO}_${ARCH}.deb \
    && curl -sLO https://github.com/wkhtmltopdf/packaging/releases/download/$WKHTMLTOPDF_VERSION/$downloaded_file \
    && apt-get install -y ./$downloaded_file \
    && rm $downloaded_file \
    # Chromium
    && if [ "$INSTALL_CHROMIUM" != "false" ]; then \
        DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        chromium-headless-shell; \
    fi \
    # Clean up
    && rm -rf /var/lib/apt/lists/* \
    && rm -fr /etc/nginx/sites-enabled/default \
    && mkdir -p /etc/nginx/snippets \
    && pip3 install frappe-bench==${BENCH_VERSION} \
    # Fixes for non-root nginx and logs to stdout
    && sed -i '/user www-data/d' /etc/nginx/nginx.conf \
    && ln -sf /dev/stdout /var/log/nginx/access.log && ln -sf /dev/stderr /var/log/nginx/error.log \
    && touch /run/nginx.pid \
    # OpenShift and arbitrary UID compatibility (GID 0 & group writable)
    && chgrp -R 0 /home/frappe /etc/nginx /var/log/nginx /var/lib/nginx /run \
    && chmod -R g=u /home/frappe /etc/nginx /var/log/nginx /var/lib/nginx /run \
    && chmod 755 /usr/local/bin/nginx-entrypoint.sh \
    && chmod 644 /templates/nginx/frappe.conf.template

# Spec 0012 AC-3: Inter as static TrueType files, pinned by release tag and checked by sha256. The
# Debian package is Inter 4, a variable font, and wkhtmltopdf cannot pick weights from one. The
# certificate needs the font here because it is drawn in this container, with no internet.
ARG INTER_VERSION=4.1
ARG INTER_ZIP_SHA256=9883fdd4a49d4fb66bd8177ba6625ef9a64aa45899767dde3d36aa425756b11e
RUN curl -fsSL -o /tmp/inter.zip \
      "https://github.com/rsms/inter/releases/download/v${INTER_VERSION}/Inter-${INTER_VERSION}.zip" \
    && echo "${INTER_ZIP_SHA256}  /tmp/inter.zip" | sha256sum -c - \
    && python3 -m zipfile -e /tmp/inter.zip /tmp/inter \
    && cd /tmp/inter/extras/ttf \
    && printf '%s\n' \
      "40d692fce188e4471e2b3cba937be967878f631ad3ebbbdcd587687c7ebe0c82  Inter-Regular.ttf" \
      "78a843fade9d4612a5567302fb595b56976eb5fcebf4fea5a5912d638bafcde3  Inter-SemiBold.ttf" \
      "288316099b1e0a47a4716d159098005eef7c0066921f34e3200393dbdb01947f  Inter-Bold.ttf" \
      | sha256sum -c - \
    && mkdir -p /usr/share/fonts/truetype/inter \
    && cp Inter-Regular.ttf Inter-SemiBold.ttf Inter-Bold.ttf /usr/share/fonts/truetype/inter/ \
    && rm -rf /tmp/inter /tmp/inter.zip \
    && fc-cache -f \
    && fc-match -f '%{family}\n' Inter | grep -x Inter

# Spec 0012 AC-9: load the Nile stylesheet on every page through one nginx include. The upstream
# template has no extension point, so the include is added after its first security headers line
# (the server block). The build fails if the line is missing, which means the template changed.
COPY deploy/nginx/nile-brand.conf /etc/nginx/snippets/nile-brand.conf
RUN sed -i '0,/security_headers.conf;/s//&\n\tinclude \/etc\/nginx\/snippets\/nile-brand.conf;/' \
      /templates/nginx/frappe.conf.template \
    && grep -c 'snippets/nile-brand.conf' /templates/nginx/frappe.conf.template | grep -x 1

FROM base AS builder

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
    # For frappe framework
    wget \
    #for building arm64 binaries
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
    # For psycopg2
    libpq-dev \
    # Other
    libffi-dev \
    liblcms2-dev \
    libldap2-dev \
    libmariadb-dev \
    libsasl2-dev \
    libtiff-dev \
    libwebp-dev \
    pkg-config \
    redis-tools \
    rlwrap \
    tk8.6-dev \
    cron \
    # For pandas
    gcc \
    build-essential \
    libbz2-dev \
    && rm -rf /var/lib/apt/lists/*

USER frappe

COPY --chown=frappe:0 apps/nile_auth /tmp/nile_auth
# Spec 0012 AC-4: the logo and icon, byte for byte from brand/. Nothing here changes them.
COPY --chown=frappe:0 brand/nile-logo.png brand/icon.png /tmp/nile_auth/nile_auth/public/images/

ARG FRAPPE_BRANCH
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG CACHE_BUST=""

# Apply group permissions after app installation and cleanup, before the runtime COPY.
RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=0 \
  : "${CACHE_BUST}" && \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi && \
  bench init ${APP_INSTALL_ARGS}\
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  echo "{}" > sites/common_site_config.json && \
  cp -r /tmp/nile_auth apps/nile_auth && \
  ./env/bin/python -m pip install --quiet -e apps/nile_auth && \
  ln -s /home/frappe/frappe-bench/apps/nile_auth/nile_auth/public sites/assets/nile_auth && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr && \
  chmod -R g=u /home/frappe/frappe-bench

FROM base AS backend

USER frappe

COPY --from=builder --chown=frappe:0 /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

# Keep the COPY destination group-writable and move assets to image-layer storage
RUN chmod g=u /home/frappe/frappe-bench && \
  cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
# This entrypoint script link build assets of the image to the mounted sites volume at container initialization
COPY --from=fd resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY --from=fd resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]
